  <fo:page-sequence master-reference="cover">
    <fo:title>Проверка возможностей fop-go</fo:title>
    <fo:flow flow-name="xsl-region-body">
      <fo:block-container absolute-position="absolute" top="0" left="0" width="60mm" height="40mm">
        <fo:block><fo:external-graphic src="url('logo.png')" content-width="60mm"/></fo:block>
      </fo:block-container>
      <fo:block-container absolute-position="absolute" top="120mm" left="0" right="0" height="40mm">
        <fo:block font-size="32pt" font-weight="bold" text-align="center" font-family="Liberation Sans" color="#1a3a6e">Проверка возможностей</fo:block>
        <fo:block font-size="16pt" text-align="center" space-before="6mm" color="#555">XSL-FO → PDF на чистом Go</fo:block>
      </fo:block-container>
      <fo:block-container absolute-position="absolute" top="200mm" left="0" width="20mm" height="60mm" reference-orientation="90" background-color="#eef3fa">
        <fo:block text-align="center" font-size="14pt" font-family="Liberation Sans">Повёрнутый текст</fo:block>
      </fo:block-container>
      <fo:block-container absolute-position="absolute" top="200mm" left="30mm" width="100mm" height="50mm">
        <fo:block><fo:external-graphic src="photo.jpg" content-width="scale-to-fit" width="100mm" height="50mm"/></fo:block>
      </fo:block-container>
      <fo:block/>
    </fo:flow>
  </fo:page-sequence>

  <fo:page-sequence master-reference="body" font-family="Liberation Serif" initial-page-number="1" id="main">
    <fo:static-content flow-name="hdr">
      <fo:block font-size="8.5pt" color="#666" border-bottom="0.5pt solid #999" font-family="Liberation Sans">
        <fo:retrieve-marker retrieve-class-name="chapter" retrieve-position="first-including-carryover"/>
      </fo:block>
    </fo:static-content>
    <fo:static-content flow-name="ftr">
      <fo:block font-size="8.5pt" color="#666" text-align="center" font-family="Liberation Sans">— <fo:page-number/> —</fo:block>
    </fo:static-content>
    <fo:flow flow-name="xsl-region-body">
      <fo:block font-family="Liberation Sans" font-size="22pt" font-weight="bold" space-after="6mm" color="#1a3a6e">Оглавление</fo:block>
      <fo:block text-align-last="justify" space-after="2mm"><fo:basic-link internal-destination="ch1" color="#1a3a6e">1. Текст и списки<fo:leader leader-pattern="dots" leader-length.maximum="100%" leader-length.minimum="10mm"/><fo:page-number-citation ref-id="ch1"/></fo:basic-link></fo:block>
      <fo:block text-align-last="justify" space-after="2mm"><fo:basic-link internal-destination="ch2" color="#1a3a6e">2. Большая таблица<fo:leader leader-pattern="dots" leader-length.maximum="100%" leader-length.minimum="10mm"/><fo:page-number-citation ref-id="ch2"/></fo:basic-link></fo:block>
      <fo:block text-align-last="justify" space-after="2mm"><fo:basic-link internal-destination="ch3" color="#1a3a6e">3. Колонки<fo:leader leader-pattern="dots" leader-length.maximum="100%" leader-length.minimum="10mm"/><fo:page-number-citation ref-id="ch3"/></fo:basic-link></fo:block>
      <fo:block break-before="page" id="ch1" font-family="Liberation Sans" font-size="18pt" font-weight="bold" keep-with-next="always" space-after="4mm" color="#1a3a6e"><fo:marker marker-class-name="chapter"><fo:inline>Глава 1. Текст и списки</fo:inline></fo:marker>1. Текст и списки</fo:block>
      <fo:block text-align="justify" space-after="3mm" text-indent="8mm">До шрифт сит амет адиписцинг таблица сит граница ут долор консектетур строка абзац амет эт консектетур строка сит элит лаборе сит шрифт сит лаборе долор сед аликва абзац до элит система темпор адиписцинг инцидидунт таблица адиписцинг амет сит ут отступ строка обработка перенос перенос таблица система эт темпор эт консектетур система отступ документов пробел аликва амет элит граница абзац эйусмод документов до отступ абзац долор амет обработка документов страница отступ перенос амет консектетур магна выравнивание амет сит система пробел аликва колонка.</fo:block>
      <fo:block text-align="justify" space-after="3mm" text-indent="8mm">Ипсум перенос страница эйусмод элит отступ сит ут аликва сед эт шрифт шрифт отступ консектетур эйусмод пробел шрифт магна сед строка магна абзац страница колонка лаборе до консектетур темпор до лаборе лаборе лорем отступ темпор долоре аликва лорем до абзац таблица обработка сед граница сит перенос шрифт шрифт шрифт шрифт адиписцинг выравнивание шрифт сит инцидидунт амет ут пробел эйусмод элит документов сит адиписцинг лорем до адиписцинг таблица ипсум амет ут колонка до долоре страница таблица выравнивание элит элит отступ перенос выравнивание выравнивание система консектетур.</fo:block>
      <fo:block text-align="justify" space-after="3mm" text-indent="8mm">Адиписцинг документов долоре выравнивание эйусмод ипсум ут таблица до ипсум система консектетур долоре таблица эйусмод страница лаборе граница документов лаборе инцидидунт эт шрифт лаборе инцидидунт отступ страница ипсум ипсум магна выравнивание долоре инцидидунт страница пробел страница таблица консектетур лаборе адиписцинг лаборе выравнивание инцидидунт документов ут выравнивание лорем выравнивание страница консектетур элит колонка инцидидунт выравнивание темпор строка документов консектетур.</fo:block>
      <fo:block text-align="justify" space-after="3mm" text-indent="8mm">Перенос шрифт консектетур эйусмод эйусмод сед ипсум до перенос до выравнивание страница до сед ипсум лорем адиписцинг сед строка инцидидунт ут ипсум долоре ут аликва граница эт обработка долоре абзац сед сит страница перенос абзац граница сед до граница ипсум пробел темпор лорем до темпор до выравнивание элит сит обработка выравнивание адиписцинг сит эт инцидидунт магна долор адиписцинг граница пробел ипсум амет пробел обработка граница граница инцидидунт магна пробел граница выравнивание граница эт долоре инцидидунт пробел сед абзац элит шрифт пробел обработка амет эт строка амет ут система элит до.</fo:block>
      <fo:block text-align="justify" space-after="3mm" text-indent="8mm">До долоре сед перенос лаборе адиписцинг шрифт отступ эйусмод лаборе эйусмод строка граница шрифт документов абзац инцидидунт страница обработка консектетур таблица ипсум документов перенос пробел ипсум колонка документов аликва граница амет элит лаборе адиписцинг консектетур долоре магна долор темпор магна сед строка долоре шрифт до граница отступ обработка консектетур магна сит темпор строка амет магна ипсум консектетур долоре консектетур лаборе амет долоре элит перенос лорем документов абзац магна сед долор эт элит эйусмод долоре сит темпор инцидидунт система система ут аликва пробел граница темпор магна страница.</fo:block>
      <fo:block text-align="justify" space-after="3mm" text-indent="8mm">Долоре долор лорем ипсум граница инцидидунт граница выравнивание эт пробел адиписцинг строка отступ шрифт граница система ут лаборе документов инцидидунт сед шрифт страница сит сед лорем амет долоре строка эйусмод сит консектетур колонка граница аликва эт аликва долор перенос темпор эйусмод магна.</fo:block>
      <fo:block text-align="justify" space-after="3mm" text-indent="8mm">Лорем долоре таблица документов обработка эт долор система ут страница темпор лорем документов колонка консектетур выравнивание магна граница инцидидунт эт граница лорем консектетур долоре консектетур до шрифт долор шрифт ипсум система система лаборе консектетур до колонка обработка отступ до аликва до долор граница строка граница сед граница ипсум лаборе консектетур ипсум долор сед таблица адиписцинг колонка пробел сит ипсум эт отступ долоре лорем перенос амет граница консектетур амет выравнивание долоре амет долоре эт ут лаборе перенос отступ колонка амет выравнивание аликва долор инцидидунт амет до документов долоре система сед лорем выравнивание сит отступ магна адиписцинг ут отступ.</fo:block>
      <fo:block text-align="justify" space-after="3mm" text-indent="8mm">Аликва перенос перенос перенос элит инцидидунт система консектетур выравнивание ипсум аликва перенос амет граница пробел магна колонка ут ут амет консектетур до долоре таблица сед граница магна элит таблица лаборе отступ отступ шрифт ипсум эйусмод лорем отступ пробел шрифт система до абзац страница колонка обработка элит документов лорем обработка документов шрифт элит инцидидунт лорем аликва долоре таблица амет шрифт колонка амет таблица строка магна сит магна адиписцинг сит аликва до эт магна строка граница обработка инцидидунт таблица.</fo:block>
      <fo:block text-align="justify" space-after="3mm" text-indent="8mm">Ипсум шрифт ут консектетур сит абзац пробел сед аликва отступ сит сед эйусмод выравнивание абзац документов аликва система долоре долоре шрифт эт система выравнивание шрифт элит эйусмод эйусмод амет ут граница отступ лаборе пробел документов пробел строка сед инцидидунт эт консектетур темпор документов консектетур обработка эт таблица долоре инцидидунт ипсум абзац колонка абзац ут колонка магна документов сит отступ магна таблица сед граница ут консектетур магна эт колонка шрифт пробел строка система ипсум сед долор строка выравнивание отступ лорем амет шрифт перенос пробел эт адиписцинг лаборе до до адиписцинг перенос консектетур долор лорем сед.</fo:block>
      <fo:block font-family="Liberation Sans" font-weight="bold" keep-with-next="always" space-before="4mm" space-after="2mm">Список</fo:block>
      <fo:list-block provisional-distance-between-starts="8mm" provisional-label-separation="2mm" space-after="4mm">
        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1.</fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block text-align="justify">Долор система сед долоре строка элит адиписцинг амет система инцидидунт колонка долоре лаборе лорем лорем система перенос.</fo:block></fo:list-item-body></fo:list-item>
        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2.</fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block text-align="justify">Обработка эт выравнивание эт эт ипсум абзац система сит ипсум инцидидунт отступ абзац консектетур долоре лаборе строка таблица.</fo:block></fo:list-item-body></fo:list-item>
        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3.</fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block text-align="justify">Отступ долор документов абзац таблица шрифт инцидидунт лорем аликва граница амет ут отступ инцидидунт система инцидидунт лаборе.</fo:block></fo:list-item-body></fo:list-item>
        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4.</fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block text-align="justify">Лаборе долоре аликва адиписцинг отступ темпор лаборе отступ абзац сит до шрифт сит ут ипсум до абзац сит сит темпор шрифт пробел обработка элит.</fo:block></fo:list-item-body></fo:list-item>
        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5.</fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block text-align="justify">Эйусмод документов инцидидунт темпор перенос долор система колонка таблица документов пробел эйусмод.</fo:block></fo:list-item-body></fo:list-item>
        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">6.</fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block text-align="justify">Лорем консектетур магна консектетур страница абзац элит ут колонка страница система строка консектетур.</fo:block></fo:list-item-body></fo:list-item>
        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">7.</fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block text-align="justify">Выравнивание инцидидунт таблица пробел инцидидунт обработка таблица выравнивание ипсум абзац эт.</fo:block></fo:list-item-body></fo:list-item>
        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">8.</fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block text-align="justify">Шрифт долор колонка долор перенос амет сит долоре инцидидунт амет документов таблица магна документов долор долоре обработка магна система лорем амет ипсум лаборе адиписцинг выравнивание перенос колонка долоре строка отступ сед отступ темпор лорем система.</fo:block></fo:list-item-body></fo:list-item>
      </fo:list-block>
      <fo:block border="1pt solid #c05050" background-color="#fdf0f0" padding="4mm" margin-left="10mm" margin-right="10mm" space-after="4mm" font-style="italic">До эт обработка обработка перенос таблица консектетур граница инцидидунт шрифт эйусмод эт абзац амет долор выравнивание обработка эйусмод строка адиписцинг амет долоре консектетур ут адиписцинг абзац отступ пробел темпор лаборе сед абзац перенос эт элит аликва аликва магна магна таблица долоре долоре инцидидунт пробел эт темпор эт эт до аликва инцидидунт обработка амет шрифт долоре эт граница лаборе адиписцинг перенос долор адиписцинг лорем выравнивание лаборе пробел таблица долор аликва лаборе элит сит инцидидунт инцидидунт амет таблица граница темпор пробел долоре лорем адиписцинг страница ут долор таблица документов до долор ут долоре долор ут лорем обработка абзац таблица темпор система амет ут долор отступ выравнивание амет абзац адиписцинг шрифт до консектетур эйусмод шрифт магна абзац аликва система абзац сит система страница абзац абзац ипсум таблица инцидидунт шрифт шрифт ут лорем строка эйусмод строка элит консектетур шрифт таблица перенос эйусмод сед лорем сит до шрифт консектетур таблица граница эйусмод до страница аликва эйусмод эйусмод амет адиписцинг колонка отступ инцидидунт система сед долор.</fo:block>
      <fo:block text-align="center" space-after="4mm"><fo:external-graphic src="photo.jpg" content-width="80mm"/></fo:block>
      <fo:block text-align="center" font-size="9pt" color="#666" space-after="6mm">Рис. 1. JPEG-изображение</fo:block>
      <fo:block font-size="16pt" space-after="2mm">Формулы: H<fo:inline baseline-shift="sub" font-size="70%">2</fo:inline>O, x<fo:inline baseline-shift="super" font-size="70%">2</fo:inline> + y<fo:inline baseline-shift="super" font-size="70%">2</fo:inline></fo:block>
      <fo:block white-space-collapse="false" white-space-treatment="preserve" linefeed-treatment="preserve" font-family="Liberation Mono" font-size="9pt" background-color="#f4f4f4" padding="3mm" space-after="4mm" wrap-option="no-wrap">func main() {
    fmt.Println("Привет, мир!")
}</fo:block>

      <fo:block break-before="page" id="ch2" font-family="Liberation Sans" font-size="18pt" font-weight="bold" keep-with-next="always" space-after="4mm" color="#1a3a6e"><fo:marker marker-class-name="chapter"><fo:inline>Глава 2. Большая таблица</fo:inline></fo:marker>2. Большая таблица</fo:block>
      <fo:block id="tbl" space-after="3mm">Таблица занимает несколько страниц, шапка повторяется на каждой из них, строки не разрываются.</fo:block>
      <fo:table table-layout="fixed" width="100%" border-collapse="collapse" font-family="Liberation Sans" font-size="9pt">
        <fo:table-column column-width="12mm"/><fo:table-column column-width="proportional-column-width(1)"/><fo:table-column column-width="28mm"/><fo:table-column column-width="22mm"/>
        <fo:table-header><fo:table-row background-color="#1a3a6e" color="white" font-weight="bold">
          <fo:table-cell padding="2mm"><fo:block>№</fo:block></fo:table-cell><fo:table-cell padding="2mm"><fo:block>Описание</fo:block></fo:table-cell><fo:table-cell padding="2mm"><fo:block text-align="end">Сумма</fo:block></fo:table-cell><fo:table-cell padding="2mm"><fo:block>Статус</fo:block></fo:table-cell>
        </fo:table-row></fo:table-header>
