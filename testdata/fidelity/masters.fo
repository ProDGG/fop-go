<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" font-family="Liberation Sans" font-size="10pt">
<fo:layout-master-set>
 <fo:simple-page-master master-name="first" page-width="200mm" page-height="250mm" margin="15mm">
  <fo:region-body margin-top="30mm" margin-bottom="15mm"/><fo:region-before extent="25mm"/><fo:region-after extent="10mm"/>
 </fo:simple-page-master>
 <fo:simple-page-master master-name="odd" page-width="200mm" page-height="250mm" margin-top="15mm" margin-bottom="15mm" margin-left="25mm" margin-right="10mm">
  <fo:region-body margin="12mm 8mm 12mm 14mm" column-count="2" column-gap="6mm"/><fo:region-before extent="10mm" display-align="center"/><fo:region-after extent="10mm" display-align="after"/><fo:region-start extent="14mm"/><fo:region-end extent="8mm"/>
 </fo:simple-page-master>
 <fo:simple-page-master master-name="even" page-width="200mm" page-height="250mm" margin-top="15mm" margin-bottom="15mm" margin-left="10mm" margin-right="25mm">
  <fo:region-body margin="12mm 14mm 12mm 8mm" column-count="2" column-gap="6mm"/><fo:region-before extent="10mm" display-align="center"/><fo:region-after extent="10mm" display-align="after"/><fo:region-start extent="8mm"/><fo:region-end extent="14mm"/>
 </fo:simple-page-master>
 <fo:simple-page-master master-name="blank" page-width="200mm" page-height="250mm" margin="20mm"><fo:region-body/><fo:region-after extent="10mm"/></fo:simple-page-master>
 <fo:page-sequence-master master-name="seq">
  <fo:single-page-master-reference master-reference="first"/>
  <fo:repeatable-page-master-alternatives>
   <fo:conditional-page-master-reference master-reference="blank" blank-or-not-blank="blank"/>
   <fo:conditional-page-master-reference master-reference="odd" odd-or-even="odd"/>
   <fo:conditional-page-master-reference master-reference="even" odd-or-even="even"/>
  </fo:repeatable-page-master-alternatives>
 </fo:page-sequence-master>
</fo:layout-master-set>
<fo:page-sequence master-reference="seq" force-page-count="end-on-even">
