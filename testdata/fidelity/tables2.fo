<fo:block space-before="10pt">separate padded</fo:block><fo:table table-layout="fixed" width="300pt" border-collapse="separate" border-spacing="4pt 6pt" background-color="#eeeeee" padding="5pt" border="1pt solid black"><fo:table-column column-width="100pt"/><fo:table-column column-width="100pt"/><fo:table-column column-width="100pt"/><fo:table-body>
