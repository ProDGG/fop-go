<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:svg="http://www.w3.org/2000/svg" font-family="Liberation Sans" font-size="10pt">
<fo:layout-master-set><fo:simple-page-master master-name="p" page-width="210mm" page-height="150mm" margin="15mm"><fo:region-body/></fo:simple-page-master></fo:layout-master-set>
<fo:page-sequence master-reference="p"><fo:flow flow-name="xsl-region-body">
<fo:block>Inline SVG:
<fo:instream-foreign-object>
<svg:svg width="300px" height="160px" viewBox="0 0 300 160">
  <svg:defs>
    <svg:linearGradient id="g1" x1="0" y1="0" x2="1" y2="0"><svg:stop offset="0" stop-color="#ff0000"/><svg:stop offset="0.5" stop-color="#ffff00"/><svg:stop offset="1" stop-color="#0000ff"/></svg:linearGradient>
    <svg:radialGradient id="g2"><svg:stop offset="0" stop-color="white"/><svg:stop offset="1" stop-color="#006600"/></svg:radialGradient>
  </svg:defs>
  <svg:rect x="5" y="5" width="120" height="60" rx="8" fill="url(#g1)" stroke="black" stroke-width="2"/>
  <svg:circle cx="190" cy="40" r="35" fill="url(#g2)" stroke="#333" stroke-dasharray="4 2"/>
  <svg:ellipse cx="260" cy="40" rx="30" ry="20" fill="orange" fill-opacity="0.5" stroke="red"/>
  <svg:path d="M 10 120 C 40 70, 80 70, 110 120 S 170 170 200 120 L 230 100 A 25 25 0 0 1 280 120 Z" fill="#8ac" stroke="navy" stroke-width="3" stroke-linejoin="round"/>
  <svg:polyline points="10,150 40,130 70,150 100,130" fill="none" stroke="green" stroke-width="2"/>
  <svg:g transform="translate(150,150) rotate(-20)"><svg:text x="0" y="0" font-size="14" fill="purple">Rotated text</svg:text></svg:g>
  <svg:text x="290" y="155" font-size="12" text-anchor="end" font-family="Times" font-weight="bold">Right <svg:tspan fill="red">edge</svg:tspan></svg:text>
</svg:svg>
</fo:instream-foreign-object> after.</fo:block>
<fo:block space-before="10pt"><fo:external-graphic src="icon.svg" content-width="100pt"/></fo:block>
</fo:flow></fo:page-sequence></fo:root>
